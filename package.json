{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "bun-app-window",
    "version": "0.2.0",
    "description": "Native WebView2 window shell for Bun — frameless or system-decorated windows, DPI-aware geometry, typed IPC, system-accurate title bar",
    "type": "module",
    "license": "MIT",
    "author": "Dolores <tiancong.li@hotmail.com> (https://github.com/TiancongLx)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TiancongLx/bun-app-window.git"
    },
    "homepage": "https://github.com/TiancongLx/bun-app-window#readme",
    "bugs": {
        "url": "https://github.com/TiancongLx/bun-app-window/issues"
    },
    "os": ["win32"],
    "cpu": ["x64"],
    "keywords": [
        "bun",
        "webview",
        "webview2",
        "frameless",
        "window",
        "desktop",
        "ffi",
        "titlebar",
        "ipc"
    ],
    "exports": {
        ".": "./src/shell/index.ts",
        "./embedded": "./src/shell/embedded.ts",
        "./debug": "./src/shell/debug.ts",
        "./state": "./src/shell/state.ts",
        "./ipc": "./src/shell/ipc.ts",
        "./titlebar": "./src/ui/titlebar.ts",
        "./native": {
            "types": "./src/shell/native-asset.d.ts",
            "default": "./dist/libshell.dll"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src/shell",
        "src/ui/titlebar.ts",
        "dist/libshell.dll",
        "README.md",
        "README.zh-CN.md",
        "README.zh-TW.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "build:native": "pwsh -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
        "build:exe": "pwsh -NoProfile -ExecutionPolicy Bypass -File native/build-pack.ps1",
        "demo": "bun run ./src/host.ts",
        "pack": "bun pm pack"
    },
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.3"
    }
}
